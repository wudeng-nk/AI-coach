# ═══ 应用配置 ═══
APP_NAME=AI Coach
APP_ENV=development
DEBUG=true

# ═══ 数据库 ═══
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_coach

# ═══ Redis ═══
REDIS_URL=redis://localhost:6379/0

# ═══ JWT 认证 ═══
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ═══ AI 服务 ═══
AI_SERVICE_MODE=mock
AI_SERVICE_BASE_URL=https://ai-service.example.com
AI_SERVICE_API_KEY=your-api-key-here
AI_SERVICE_TIMEOUT=30

# ═══ CORS ═══
CORS_ORIGINS=["http://localhost:3000","http://localhost:5000"]
